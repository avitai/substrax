# The environment that writes the format-2 checkpoint fixtures: the substrax release that
# produced the format and the numerical stack it ran with. `format2_fixture_requirements.txt`
# is compiled from this file and committed, so the environment neither floats with PyPI
# between two CI jobs nor drifts with the project's own lock. Recompile deliberately, from the
# repository root:
#
#     uv pip compile --universal --python-version 3.12 \
#         scripts/format2_fixture_requirements.in -o scripts/format2_fixture_requirements.txt
substrax==0.1.5
optax==0.2.8
jax==0.11.1
jaxlib==0.11.1
flax==0.12.9
