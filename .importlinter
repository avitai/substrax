# Layering contracts, checked by `uv run lint-imports`. Kept outside pyproject.toml because
# toml-sort reorders arrays and the order of a layers contract is its meaning.
[importlinter]
root_package = substrax
include_external_packages = True

[importlinter:contract:layers]
name = spmd builds on mesh, mesh on devices
type = layers
layers =
    substrax.spmd
    substrax.mesh
    substrax.devices

[importlinter:contract:leaves]
name = checkpoint, callbacks and tracking do not import the sharding layers
type = forbidden
source_modules =
    substrax.callbacks
    substrax.checkpoint
    substrax.tracking
forbidden_modules =
    substrax.mesh
    substrax.spmd

[importlinter:contract:process_setup]
name = runtime, artifacts, rng and optim are leaves that import no other subpackage
type = forbidden
source_modules =
    substrax.artifacts
    substrax.optim
    substrax.rng
    substrax.runtime
forbidden_modules =
    substrax.callbacks
    substrax.checkpoint
    substrax.devices
    substrax.mesh
    substrax.spmd
    substrax.tracking

[importlinter:contract:testing]
name = only testing imports pytest and no other subpackage imports testing
type = forbidden
source_modules =
    substrax.artifacts
    substrax.callbacks
    substrax.checkpoint
    substrax.devices
    substrax.mesh
    substrax.optim
    substrax.rng
    substrax.runtime
    substrax.spmd
    substrax.tracking
forbidden_modules =
    pytest
    substrax.testing

[importlinter:contract:siblings]
name = substrax never imports a sibling package
type = forbidden
source_modules =
    substrax
forbidden_modules =
    artifex
    calibrax
    datarax
    opifex

[importlinter:contract:source_scans]
name = the source scans read files with the standard library only
type = forbidden
source_modules =
    substrax.testing.source_scans
forbidden_modules =
    flax
    jax
    numpy
    pytest
    substrax.artifacts
    substrax.callbacks
    substrax.checkpoint
    substrax.devices
    substrax.mesh
    substrax.optim
    substrax.rng
    substrax.runtime
    substrax.spmd
    substrax.tracking
